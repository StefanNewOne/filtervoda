# filtervoda.mk — environment variables (documented; NO real values here)
# Copy to .env.local for local dev. Staging/production live only on the deploy machine / VPS.
# Every variable is Zod-validated at API startup — the app refuses to start if a required one is missing.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                       # development | staging | production
PORT=3001                                   # API port (optional; default 3001)
PUBLIC_SITE_URL=http://localhost            # public storefront origin (Origin/Referer allowlist for /leads)
ADMIN_URL=http://localhost/admin            # admin app origin
SITE_DOMAIN=localhost                       # prod: Caddy auto-TLS domain (e.g. filtervoda.mk)

# ── Database / cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://filtervoda:filtervoda@postgres:5432/filtervoda?schema=public
REDIS_URL=redis://redis:6379
# Compose-level Postgres credentials (must match DATABASE_URL); also used by backup.sh.
POSTGRES_USER=filtervoda
POSTGRES_PASSWORD=filtervoda
POSTGRES_DB=filtervoda

# ── Secrets (generate strong random values; each >= 16 chars) ────────────────
SESSION_SECRET=change-me-32-chars-minimum   # express-session signing (min 16)
CRON_SECRET=change-me-16-chars-min          # guards GET /api/v1/cron/* HTTP triggers (min 16)
IP_HASH_SECRET=change-me-16-chars-min        # HMAC key for Lead.ipHash (never store raw IP) (min 16)
PREVIEW_SECRET=change-me-16-chars-min        # signs draft-preview tokens (1h) (min 16)
INTERNAL_API_SECRET=change-me-16-chars-min   # lets trusted SSR calls bypass the public read rate limiter

# ── Seed user passwords (required to create users on a FRESH production DB) ───
SEED_ADMIN_PASSWORD=                         # dev falls back to a built-in default; prod requires this
SEED_EDITOR_PASSWORD=
SEED_CLIENT_PASSWORD=

# ── Mail (Mailhog local: host=mailhog port=1025, no auth) ────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SPAR Company <no-reply@filtervoda.mk>"
NOTIFY_EMAILS=info@filtervoda.mk            # comma-separated, up to 3 — new-lead notifications

# ── Tracking (Meta Pixel ID is the existing one) ─────────────────────────────
META_PIXEL_ID=1957593378149639
META_CAPI_TOKEN=                             # Conversions API access token
META_TEST_EVENT_CODE=                        # staging only
GA4_ID=
GTM_ID=

# ── Anti-spam (Cloudflare Turnstile) ─────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DEV_BYPASS=true                    # dev only: skip token verification until keys exist

# ── Media storage (StorageService) ───────────────────────────────────────────
STORAGE_DRIVER=s3                            # s3 (MinIO local) | cloudinary (prod, ADR-003)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=filtervoda-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional integrations ────────────────────────────────────────────────────
WEBHOOK_URL=                                 # optional outbound webhook on new lead
TELEGRAM_BOT_TOKEN=                          # optional operator alert
TELEGRAM_CHAT_ID=
SENTRY_DSN=                                  # SHOULD (Phase 3)

# ── Deploy machine only (never on app servers, never committed) ──────────────
VPS_IP=
DEPLOY_SSH_USER=
DEPLOY_SSH_PRIVATE_KEY=
STORAGE_BOX_TARGET=                          # optional: rsync target for off-box backups (backup.sh)
