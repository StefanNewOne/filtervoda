# filtervoda.mk — PRODUCTION env template. Copy to .env.production (gitignored), fill values.
# Used by scripts/deploy-vps.sh (deploy machine) AND shipped to the VPS as the app env.
# Every app var is Zod-validated at API startup — the app refuses to start if one is missing.

# ── Deploy machine only (how deploy-vps.sh reaches the VPS) ───────────────────
VPS_IP=135.181.156.104
DEPLOY_SSH_USER=root
DEPLOY_SSH_PRIVATE_KEY=~/.ssh/filtervoda_vps    # path on YOUR machine; never shipped
SITE_DOMAIN=135.181.156.104.sslip.io            # sslip.io preview now → filtervoda.mk later

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PUBLIC_SITE_URL=https://135.181.156.104.sslip.io   # must match SITE_DOMAIN (https)
ADMIN_URL=https://135.181.156.104.sslip.io/admin

# ── Database / cache (in-cluster; not exposed to the internet) ────────────────
POSTGRES_USER=filtervoda
POSTGRES_PASSWORD=CHANGE_ME_strong               # generated for you at deploy
POSTGRES_DB=filtervoda
DATABASE_URL=postgresql://filtervoda:CHANGE_ME_strong@postgres:5432/filtervoda?schema=public
REDIS_URL=redis://redis:6379

# ── Secrets (generated strong values) ────────────────────────────────────────
SESSION_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME
IP_HASH_SECRET=CHANGE_ME
PREVIEW_SECRET=CHANGE_ME
INTERNAL_API_SECRET=CHANGE_ME       # trusted SSR↔API header; bypasses public read rate limit
PAGE_CACHE_TTL_SEC=300              # storefront full-page Redis cache TTL

# ── Mail (production SMTP [D-7]) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SPAR Company <no-reply@filtervoda.mk>"
NOTIFY_EMAILS=info@filtervoda.mk                 # comma-separated, up to 3

# ── Tracking (existing Meta Pixel) ───────────────────────────────────────────
META_PIXEL_ID=1957593378149639
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
GA4_ID=
GTM_ID=

# ── Anti-spam (Cloudflare Turnstile [D-2]) ───────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DEV_BYPASS=false                       # MUST be false in production

# ── Media storage (Cloudinary [D-6], chosen) ─────────────────────────────────
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CDN_BASE_URL=

# ── Optional integrations ────────────────────────────────────────────────────
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
